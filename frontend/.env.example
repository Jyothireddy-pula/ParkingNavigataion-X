# Backend URL — leave blank in dev (Vite proxy forwards /api to localhost:8000)
# VITE_API_BASE=https://your-backend.onrender.com

# Google Maps JavaScript API key
# Required for the embedded Google Maps view in the Find Parking tab.
# Without it the tab falls back to the existing Leaflet/OpenStreetMap map.
# Get a key at https://console.cloud.google.com/ — enable "Maps JavaScript API"
# and "Maps Embed API". Restrict the key to your domain(s).
VITE_GOOGLE_MAPS_API_KEY=
